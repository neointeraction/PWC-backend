generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "rhel-openssl-3.0.x" for Vercel's Node 18/20 serverless
  // runtime (Amazon Linux 2023) so the query-engine binary is present when deployed.
  // If you see "Query engine binary not found" on Vercel, try "rhel-openssl-1.0.x".
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  COUNSELLOR
  ADMIN
  SUPER_ADMIN
  VIEW_ONLY_ADMIN // same read access as an admin, but every write is blocked
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  role               UserRole
  firstName          String
  lastName           String
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  student             Student?
  counsellor          Counsellor?
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Stores hashed refresh tokens so individual sessions can be revoked.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

// Stores hashed, single-use password-reset tokens (forgot-password flow). Only the hash
// is persisted — the raw token lives only in the emailed reset link.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// Monotonic counters for human-readable entity codes (Student "S0001", Counsellor
// "C0001", Project "P0001"). One row per entity type keyed by `key`; `value` is the last
// number issued. Incremented atomically inside the same transaction as the entity create
// via nextCode() (src/common/utils/codeSequence.ts) so a rolled-back create leaves no gap.
model CodeSequence {
  key       String   @id // "STUDENT" | "COUNSELLOR" | "PROJECT"
  value     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("code_sequences")
}

// Lookup of counselling cohorts (e.g. Class 9-10). `code` is the canonical string used
// across the app's cohort-scoped content (FormTemplate.cohort, AssessmentQuestion.cohort,
// AssessmentAttempt.cohort) — those columns stay plain strings that MATCH this code, not
// FKs (deliberate: avoids a big migration while there's a single cohort). This table is a
// read-only source of truth to populate cohort dropdowns; no CRUD yet.
model Cohort {
  id           String   @id @default(cuid())
  code         String   @unique // "CLASS_9_10" — matches the cohort strings elsewhere
  name         String // human label, e.g. "Class 9 & 10"
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("cohorts")
}

// Read-only lookup for the language a project is delivered in. English is seeded as the
// default; a project picks it up automatically unless another language is chosen (future).
// Add more rows to offer them in the project-creation dropdown.
model Language {
  id           String   @id @default(cuid())
  code         String   @unique // BCP 47 / ISO 639-1, e.g. "en"
  name         String // human label, e.g. "English"
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false) // exactly one row is the default (English today)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects Project[]

  @@map("languages")
}

// Tenant (educational institution). Onboarded by Super Admin.
model Institute {
  id            String   @id @default(cuid())
  name          String   @unique
  address       String
  contactNumber String   @unique
  primaryEmail  String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  classes     InstituteClass[]
  counsellors Counsellor[]
  projects    Project[]

  @@map("institutes")
}

model InstituteClass {
  id          String    @id @default(cuid())
  name        String
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  divisions InstituteDivision[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("institute_classes")
}

model InstituteDivision {
  id        String         @id @default(cuid())
  name      String
  classId   String
  class     InstituteClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  students Student[]

  @@unique([classId, name])
  @@index([classId])
  @@map("institute_divisions")
}

enum ProjectStatus {
  ACTIVE
  CLOSED
  DELETED // soft-delete — hidden from default listings, restorable to ACTIVE
}

// A counselling cycle/cohort run for an institute (e.g. "2026 Batch, Class 9-10").
// Workflow status, forms, assessments, sessions and reports are all scoped to a Project;
// closing a project is the data-purge boundary.
model Project {
  id          String        @id @default(cuid())
  // Auto-generated human-readable id, e.g. "P0001". Nullable at the DB level for the
  // pre-code backfill (and raw test fixtures); the service always sets it on create, so
  // projects created through the API are never null — same pattern as `languageId`.
  code        String?       @unique
  instituteId String
  institute   Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  fromDate    DateTime
  toDate      DateTime
  status      ProjectStatus @default(ACTIVE)
  // Delivery language. Nullable at the DB level for the pre-language backfill; the service
  // always resolves it to the default (English) on create, so new projects are never null.
  languageId  String?
  language    Language?     @relation(fields: [languageId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  students        Student[]
  counsellors     ProjectCounsellor[]
  counsellorSlots CounsellorSlot[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@index([languageId])
  @@map("projects")
}

// Counsellor belongs to one institute; assigned to specific projects via ProjectCounsellor.
model Counsellor {
  id             String    @id @default(cuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  counsellorCode String    @unique // admin-generated human-readable id, e.g. "CN1"
  instituteId    String
  institute      Institute @relation(fields: [instituteId], references: [id])
  mobile         String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  slots            CounsellorSlot[]
  projects         ProjectCounsellor[]
  studentsAssigned Session[]

  @@index([instituteId])
  @@map("counsellors")
}

model ProjectCounsellor {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  counsellorId String
  counsellor   Counsellor @relation(fields: [counsellorId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([projectId, counsellorId])
  @@index([counsellorId])
  @@map("project_counsellors")
}

enum SlotStatus {
  OPEN
  BOOKED
}

// Discrete, individually-bookable slot. Fed into the system once, at project creation,
// from the institute's counsellor-availability sheet (Counsellor, Date, Time Slot) — see
// docs/session-scheduling-use-cases.md, resolved decisions #1 and B. Never added to
// afterward; a slot moves OPEN -> BOOKED when a Session is created against it, and back
// to OPEN if that Session is cancelled.
model CounsellorSlot {
  id           String     @id @default(cuid())
  counsellorId String
  counsellor   Counsellor @relation(fields: [counsellorId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slotDate     DateTime   @db.Date
  startTime    String // "HH:mm", 24h
  endTime      String // "HH:mm", 24h
  status       SlotStatus @default(OPEN)
  sessionId    String?    @unique
  session      Session?   @relation(fields: [sessionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([counsellorId, slotDate, startTime])
  @@index([projectId, slotDate, startTime])
  @@index([counsellorId, status])
  @@map("counsellor_slots")
}

enum WorkflowStatus {
  DRAFT
  PROFILE_COMPLETED
  PRE_COUNSELLING_FORMS_SUBMITTED
  ASSESSMENT_PENDING
  ASSESSMENT_COMPLETED
  SESSION_SCHEDULED
  SESSION_1_COMPLETED
  COUNSELLOR_FEEDBACK_REPORT
  SESSION_2_COMPLETED
  COUNSELLOR_FEEDBACK
  STUDENT_PARENT_FEEDBACK
  CLOSED
}

model Student {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentCode      String            @unique // admin-generated login id, e.g. "CB1"
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  divisionId       String
  division         InstituteDivision @relation(fields: [divisionId], references: [id])
  mobile           String            @unique
  whatsappNumber   String?
  // Primary contact for parent communication (session links, pre-counselling/feedback
  // links) — captured on the Student Profile Form, Section A.
  parentMobile     String            @unique
  parentEmail      String            @unique
  // Student Profile Form, Section B/C — captured separately per parent.
  fatherName       String
  fatherOccupation String?
  fatherEmployer   String?
  motherName       String?
  motherOccupation String?
  motherEmployer   String?
  academicYear     String? // e.g. "2025-26"; shown on the Counsellor Chart "Our Champion" panel
  workflowStatus   WorkflowStatus    @default(DRAFT)
  // Last time the scheduler sent this student a follow-up nudge (idle/missed-session).
  // Drives the IDLE_NUDGE_COOLDOWN_DAYS throttle; null = never nudged.
  lastNudgeAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  sessions           Session[]
  formSubmissions    FormSubmission[]
  assessmentAttempts AssessmentAttempt[]
  counsellorChart    CounsellorChart?
  reports            Report[]

  @@index([projectId])
  @@index([divisionId])
  @@map("students")
}

enum SessionNumber {
  SESSION_1
  SESSION_2
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  RESCHEDULED
  CANCELLED
}

enum CancellationReason {
  STUDENT_UNAVAILABLE
  COUNSELLOR_UNAVAILABLE
  INSTITUTION_REQUEST
  OTHER
}

// Session 1 is booked blind (student picks an open slot; counsellor is derived from the
// slot owner). Session 2 must reuse the same counsellorId as Session 1 (enforced in service).
model Session {
  id                   String              @id @default(cuid())
  studentId            String
  student              Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  counsellorId         String
  counsellor           Counsellor          @relation(fields: [counsellorId], references: [id])
  sessionNumber        SessionNumber
  scheduledDate        DateTime            @db.Date
  startTime            String // "HH:mm"
  endTime              String // "HH:mm"
  status               SessionStatus       @default(SCHEDULED)
  // Plain, opaque string — manually populated (e.g. Admin pastes a link). No
  // Calendly/Google Meet integration yet, see docs/session-scheduling-use-cases.md
  // resolved decision D. Also shared as-is with the parent (decision I).
  meetingLink          String?
  studentJoinedAt      DateTime?
  counsellorJoinedAt   DateTime?
  studentNoShow        Boolean             @default(false)
  counsellorNoShow     Boolean             @default(false)
  notes                String?
  cancellationReason   CancellationReason?
  cancellationNotes    String?
  rescheduledFromDate  DateTime?           @db.Date
  rescheduledFromStart String?
  // Set by the scheduler when the same-day reminder for this session has been sent, so a
  // repeated daily run never double-sends. Null = not yet reminded.
  dayReminderSentAt    DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  slot CounsellorSlot?

  @@unique([studentId, sessionNumber])
  @@unique([counsellorId, scheduledDate, startTime])
  @@index([studentId])
  @@index([counsellorId])
  @@map("sessions")
}

enum AiResilienceGrade {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum CareerLibraryStatus {
  DRAFT
  ACTIVE
}

// UG vs PG, used to scope the canonical entrance-exam / course lookups.
enum QualificationLevel {
  UG
  PG
}

// Central, PWC-owned career library (default ~1,300 roles).
model CareerLibraryEntry {
  id                  String            @id @default(cuid())
  // Classification is normalized into the CareerCluster → CareerIndustry → CareerDomain
  // hierarchy. The entry points at its leaf domain; cluster/industry are derived by walking
  // up the relations. See docs/career-library-normalization-spec.md.
  domainId            String
  domain              CareerDomain      @relation(fields: [domainId], references: [id])
  jobRole             String
  aiResilienceGrade   AiResilienceGrade
  aiResilienceComment String
  oneLineDescription  String
  // Longer-form editorial fields from the source workbook (yellow columns): a full
  // role write-up and the key skill requirements (comma-separated list in the source).
  roleOverview        String?
  keySkills           String[]
  topCompanies        String[]

  // Raw range text is always kept (source data includes non-numeric values like
  // "0–Limitless" / "$0–Millions"); parsed min/max is best-effort and null when the
  // range couldn't be parsed to a number.
  salaryIndiaRangeText  String? // e.g. "₹6–25 LPA"
  salaryIndiaMinLPA     Float?
  salaryIndiaMaxLPA     Float?
  salaryGlobalRangeText String? // e.g. "$70k–$160k"
  salaryGlobalMinUSD    Float?
  salaryGlobalMaxUSD    Float?

  // Three distinct qualification levels, matching the source "Career Library" sheet.
  // Each has a raw column plus a cleaned/normalized "DEFINED" variant (yellow columns in
  // the workbook); `qualification10th12thExplanation` is the "10+2 Explanation" note.
  qualification10th12th            String
  qualification10th12thExplanation String?
  qualificationGraduation          String?
  qualificationGraduationDefined   String?
  qualificationPG                  String?
  qualificationPGDefined           String?

  // UG-level: full descriptive text plus a cleaned/short list (the latter is the join
  // key against UgEntranceExam.examName). PG-level exams are a separate list.
  entranceExamsUGDescription String?
  entranceExams              String[] // UG level, extracted/short names
  entranceExamsPG            String[]

  // Source sheet distinguishes certifications recommended before vs during UG.
  certificationsStudent String[]
  certificationsUG      String[]

  topCourses String[]
  status     CareerLibraryStatus @default(ACTIVE)
  createdBy  String // User id (admin/super admin), or a seed/import label
  updatedBy  String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  requests CareerLibraryRequest[]

  // Normalized many-to-many links (the String[] columns above are kept transitionally and
  // dropped once these are verified — see docs/career-library-normalization-spec.md).
  entranceExamLinks CareerEntranceExam[]
  courseLinks       CareerCourse[]
  institutionLinks  CareerInstitution[]
  educationLinks    CareerEducationEntry[]

  @@index([domainId])
  @@map("career_library_entries")
}

// --- Career taxonomy: a fixed 3-level hierarchy (Cluster → Industry → Domain), admin-managed.
// Domain names repeat across industries (e.g. "Academia" under Law and Political Science), so a
// domain is unique per-industry, not globally. Soft-deleted via `deletedAt` (null = live): a
// deleted node is hidden from pickers but keeps its FK so existing job roles still resolve.
// Name uniqueness is enforced by partial unique indexes over live rows only (see the migration),
// so a soft-deleted name can be reused. ---
model CareerCluster {
  id         String           @id @default(cuid())
  name       String
  deletedAt  DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  industries CareerIndustry[]

  @@map("career_clusters")
}

model CareerIndustry {
  id        String         @id @default(cuid())
  clusterId String
  cluster   CareerCluster  @relation(fields: [clusterId], references: [id])
  name      String
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  domains   CareerDomain[]

  @@index([clusterId])
  @@map("career_industries")
}

model CareerDomain {
  id         String               @id @default(cuid())
  industryId String
  industry   CareerIndustry       @relation(fields: [industryId], references: [id])
  name       String
  deletedAt  DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  entries    CareerLibraryEntry[]

  educationEntries DomainEducationEntry[]

  @@index([industryId])
  @@map("career_domains")
}

// --- Education Path: the qualifications/programmes that lead into a domain. Held at the
// DOMAIN level (not per job role) so every role in the domain inherits the same tick-list,
// and a new entry added while creating one role is available to every future role there.
// Soft-deleted like the taxonomy (null = live): a deleted row leaves the pickers but keeps
// its links resolving. Name uniqueness among live siblings is enforced in the service.
// The flat qualification*/certifications* strings on CareerLibraryEntry are the older,
// free-text layer and are intentionally left untouched — they carry descriptive prose from
// the source workbook, not a list, so there is nothing to dual-write. ---
enum EducationPathLevel {
  CLASS_10_PLUS_2
  GRADUATE
  POST_GRADUATE
  CERTIFICATION_STUDENT
  CERTIFICATION_UG
}

model DomainEducationEntry {
  id          String             @id @default(cuid())
  domainId    String
  domain      CareerDomain       @relation(fields: [domainId], references: [id])
  level       EducationPathLevel
  programme   String // e.g. "B.Tech Computer Science"
  description String?
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  careerLinks CareerEducationEntry[]

  @@index([domainId])
  @@map("domain_education_entries")
}

model CareerEducationEntry {
  careerEntryId    String
  educationEntryId String
  careerEntry      CareerLibraryEntry   @relation(fields: [careerEntryId], references: [id], onDelete: Cascade)
  educationEntry   DomainEducationEntry @relation(fields: [educationEntryId], references: [id], onDelete: Cascade)
  createdAt        DateTime             @default(now())

  @@id([careerEntryId, educationEntryId])
  @@index([educationEntryId])
  @@map("career_education_entries")
}

// --- UG/PG reference data, imported from the Career Library workbook. Each model
// mirrors one workbook tab 1:1. No FK relations to CareerLibraryEntry — these are
// matched by value at query time (see docs/db-design.md for the mapping):
//   UgInstitution.industry        <-> CareerLibraryEntry.industry
//   UgEntranceExam.examName       <-> CareerLibraryEntry.entranceExams (UG, extracted)
//   UgCourse.careerCluster        <-> CareerLibraryEntry.cluster
// ---

// Source tab: "UG Institutions_IND" — institutions mapped per industry (one
// institution can appear multiple times, once per industry it offers programmes in).
model UgInstitution {
  id                            String   @id @default(cuid())
  industry                      String
  shortName                     String?
  name                          String
  city                          String?
  state                         String?
  type                          String?
  category                      String?
  programmesOffered             String?
  programmesOfferedAfterClass12 String?
  keyProgrammesOffered          String?
  primaryEntranceExams          String?
  nirfRanking                   String?
  otherRankings                 String?
  approxAnnualFee               String?
  approxPlacementCtc            String?
  website                       String?
  createdAt                     DateTime @default(now())

  @@index([industry])
  @@index([name])
  @@map("ug_institutions")
}

// Source tab: "UG Inst+Uty_IND" — general institution/university directory, not
// industry-mapped (deduplicated, one row per institution).
model UgInstitutionUniversity {
  id                   String   @id @default(cuid())
  shortName            String?
  name                 String
  city                 String?
  state                String?
  type                 String?
  category             String?
  keyProgrammesOffered String?
  primaryEntranceExams String?
  nirfRanking          String?
  otherRankings        String?
  approxAnnualFee      String?
  approxPlacementCtc   String?
  website              String?
  createdAt            DateTime @default(now())

  @@index([name])
  @@map("ug_institutions_universities")
}

// Source tab: "UG Entrance_IND".
model UgEntranceExam {
  id                      String   @id @default(cuid())
  examName                String
  fullForm                String?
  conductingBody          String?
  level                   String?
  applicableFor           String?
  subjectRequirements12th String?
  applicationWindow       String?
  examMonth               String?
  resultMonth             String?
  examMode                String?
  frequency               String?
  approxAttemptsAllowed   String?
  officialWebsite         String?
  createdAt               DateTime @default(now())

  @@index([examName])
  @@map("ug_entrance_exams")
}

// Source tab: "UG Courses_IND".
model UgCourse {
  id                     String   @id @default(cuid())
  courseName             String
  fullForm               String?
  level                  String?
  durationYears          String? // free text, e.g. "5.5 (incl 1yr internship)"
  careerCluster          String
  stream12thRequirements String?
  minimumEligibility     String?
  entranceExamsPrimary   String?
  entranceExamsAlternate String?
  topSpecialisations     String?
  topGovtColleges        String?
  topPrivateColleges     String?
  approxAnnualFeeRange   String?
  furtherStudyOptions    String?
  createdAt              DateTime @default(now())

  @@index([careerCluster])
  @@map("ug_courses")
}

// Source tab: "PG Institutions_IND".
model PgInstitution {
  id           String   @id @default(cuid())
  industry     String?
  institution  String
  state        String?
  city         String?
  programTypes String?
  website      String?
  createdAt    DateTime @default(now())

  @@index([industry])
  @@index([institution])
  @@map("pg_institutions")
}

// Source tab: "PG Entrance_IND".
model PgEntranceExam {
  id              String   @id @default(cuid())
  examName        String
  coursesForExam  String?
  officialWebsite String?
  createdAt       DateTime @default(now())

  @@index([examName])
  @@map("pg_entrance_exams")
}

// --- Canonical lookups for career-library normalization ---
// Deduped, dropdown-friendly lists (seeded from the Ug*/Pg* import directories above +
// backfilled from existing career entries). Careers link to these via the join tables
// below. See docs/career-library-normalization-spec.md.

model EntranceExam {
  id                      String             @id @default(cuid())
  name                    String
  level                   QualificationLevel
  fullForm                String?
  conductingBody          String?
  officialWebsite         String?
  // Curated detail captured by the admin "add exam" form (mirrors UgEntranceExam's
  // columns, which only ever existed on the raw import dump).
  examMode                String? // e.g. "Computer-based (CBT)"
  frequency               String? // e.g. "Twice a year"
  applicableFor           String? // which courses/streams the exam gates
  subjectRequirements12th String?
  applicationWindow       String?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  careerLinks CareerEntranceExam[]

  @@unique([name, level])
  @@index([name])
  @@map("entrance_exams")
}

model Institution {
  id                    String   @id @default(cuid())
  name                  String   @unique
  shortName             String? // abbreviation, e.g. "IIT-B"
  city                  String?
  state                 String?
  type                  String?
  website               String?
  // Curated detail from the admin "add institution" form (mirrors UgInstitution).
  entranceExamsRequired String?
  programmesOffered     String?
  ranking               String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  careerLinks CareerInstitution[]

  @@index([name])
  @@map("institutions")
}

model Course {
  id                     String             @id @default(cuid())
  name                   String
  level                  QualificationLevel
  fullForm               String?
  durationYears          String?
  // Curated detail from the admin "add course" form (mirrors UgCourse). These stay free
  // text rather than FKs to EntranceExam/Institution — a course is reference data, not a
  // second place to curate the per-career links.
  stream12thRequirements String?
  relevantEntranceExams  String?
  programmesOffered      String?
  topColleges            String?
  furtherStudyOptions    String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  careerLinks CareerCourse[]

  @@unique([name, level])
  @@index([name])
  @@map("courses")
}

// --- Career ↔ lookup join tables (many-to-many, curated per job role) ---

model CareerEntranceExam {
  careerEntryId  String
  entranceExamId String
  careerEntry    CareerLibraryEntry @relation(fields: [careerEntryId], references: [id], onDelete: Cascade)
  entranceExam   EntranceExam       @relation(fields: [entranceExamId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@id([careerEntryId, entranceExamId])
  @@index([entranceExamId])
  @@map("career_entrance_exams")
}

model CareerInstitution {
  careerEntryId String
  institutionId String
  careerEntry   CareerLibraryEntry @relation(fields: [careerEntryId], references: [id], onDelete: Cascade)
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@id([careerEntryId, institutionId])
  @@index([institutionId])
  @@map("career_institutions")
}

model CareerCourse {
  careerEntryId String
  courseId      String
  careerEntry   CareerLibraryEntry @relation(fields: [careerEntryId], references: [id], onDelete: Cascade)
  course        Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())

  @@id([careerEntryId, courseId])
  @@index([courseId])
  @@map("career_courses")
}

enum CareerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Counsellor-submitted request to add an unlisted career; reviewed by Admin/Super Admin.
model CareerLibraryRequest {
  id                 String              @id @default(cuid())
  requestedById      String // Counsellor id
  jobTitle           String
  suggestedCluster   String
  suggestedIndustry  String
  suggestedDomain    String?
  oneLineDescription String
  justification      String
  referenceLinks     String[]
  status             CareerRequestStatus @default(PENDING)
  reviewedBy         String? // User id (admin/super admin)
  reviewedAt         DateTime?
  resultingEntryId   String?
  resultingEntry     CareerLibraryEntry? @relation(fields: [resultingEntryId], references: [id])
  createdAt          DateTime            @default(now())

  @@index([requestedById])
  @@index([status])
  @@map("career_library_requests")
}

enum FormType {
  STUDENT_PROFILE
  PRE_COUNSELLING_STUDENT
  PRE_COUNSELLING_PARENT
  FEEDBACK_STUDENT
  FEEDBACK_PARENT
}

enum SubmittedByRole {
  STUDENT
  PARENT
}

// Question bank content is not yet supplied by PWC; kept generic/JSON-driven so the
// engine is shared across cohorts while content stays cohort-specific.
model FormTemplate {
  id        String   @id @default(cuid())
  formType  FormType
  cohort    String // e.g. "CLASS_9_10"
  version   Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  questions   FormQuestion[]
  submissions FormSubmission[]

  @@unique([formType, cohort, version])
  @@map("form_templates")
}

enum QuestionType {
  MCQ_SINGLE // radio group, single answer, optionally with an "Any Other" free-text option
  MCQ_MULTI // checkbox group, multiple answers, optionally with an "Any Other" free-text option
  SHORT_TEXT // single-line text input, e.g. "My favourite subject:"
  OPEN_TEXT // multi-line textarea
  NUMBER
  SCALE // fixed 1-5 rating scale (effectiveness / clarity scales on feedback forms)
  MATRIX // a table/grid question (e.g. per-subject marks, per-strength rating rows).
  // `options` describes the grid shape; the submitted answer is a single Json object
  // keyed by each sub-field's fieldKey rather than one row per cell.
}

// One row per "Q<n>" question as it appears on the source form (see docs/db-design.md
// for the source HTML files). Matrix/table-style questions (e.g. the academic marks
// table, the strengths rating grid) are kept as a single row with a structured
// `options` shape rather than exploded per cell, so the form renders and reports as
// the original numbered question.
model FormQuestion {
  id                String       @id @default(cuid())
  formTemplateId    String
  formTemplate      FormTemplate @relation(fields: [formTemplateId], references: [id], onDelete: Cascade)
  order             Int
  questionCode      String // e.g. "Q1", "sse_q1" — matches the source form's numbering
  fieldKey          String // matches the source HTML's `name` attribute
  sectionLabel      String? // e.g. "Section 1 — My Academic Record"
  questionText      String
  helpText          String?
  questionType      QuestionType
  options           Json? // MCQ: [{value,label}]; MATRIX: {fields:[{key,label,type}], rows:[{key,label}]}
  allowOtherText    Boolean      @default(false)
  otherTextFieldKey String?
  isRequired        Boolean      @default(true)

  answers FormAnswer[]

  @@unique([formTemplateId, fieldKey])
  @@unique([formTemplateId, order])
  @@index([formTemplateId])
  @@map("form_questions")
}

model FormSubmission {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  formTemplateId  String
  formTemplate    FormTemplate    @relation(fields: [formTemplateId], references: [id])
  submittedByRole SubmittedByRole
  submittedAt     DateTime?
  createdAt       DateTime        @default(now())

  answers FormAnswer[]

  @@unique([studentId, formTemplateId, submittedByRole])
  @@index([studentId])
  @@map("form_submissions")
}

model FormAnswer {
  id           String         @id @default(cuid())
  submissionId String
  submission   FormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     FormQuestion   @relation(fields: [questionId], references: [id])
  answer       Json

  @@unique([submissionId, questionId])
  @@map("form_answers")
}

enum AssessmentSection {
  RIASEC
  BIG_FIVE
  APTITUDE
  COGNITIVE
}

enum AssessmentQuestionFormat {
  LIKERT_5 // "Type A" agreement questions, 1 (Strongly Disagree) - 5 (Strongly Agree)
  MCQ_SINGLE // "Type B" aptitude questions, single correct answer
}

enum AssessmentDifficulty {
  EASY
  MEDIUM
  HARD
}

// Single shared engine across cohorts; question bank content is cohort-specific.
// Currently seeded for cohort "CLASS_9_10" from the supplied question bank
// (RIASEC interest inventory, Big Five personality, Aptitude reasoning, Cognitive &
// decision style) — PWC's full scoring/weighting logic for career-stream mapping is
// still pending beyond the per-question weight/correctOption captured here.
model AssessmentQuestion {
  id            String                   @id @default(cuid())
  cohort        String
  section       AssessmentSection
  order         Int // logical/grouped order (RIASEC 1-24, Big Five 25-44, Aptitude 45-64, Cognitive 65-73)
  displayOrder  Int // presentation position shown to the student — interleaves traits/sections so mirror-pair and reverse-keyed items are spread apart (anti-gaming). Source: questionnaire PDF parenthetical numbers.
  questionCode  String // e.g. "Q1"
  fieldKey      String // matches the source HTML's `name` attribute
  questionText  String
  format        AssessmentQuestionFormat
  options       Json? // MCQ_SINGLE only: [{value,label}]; null for LIKERT_5 (fixed 1-5 scale)
  trait         String // e.g. "REALISTIC", "OPENNESS", "NUMERICAL"
  traitCode     String? // e.g. "R1", "NR1"
  difficulty    AssessmentDifficulty? // aptitude questions only
  weight        Float                    @default(1)
  correctOption String? // aptitude (MCQ_SINGLE) questions only
  createdAt     DateTime                 @default(now())

  answers AssessmentAnswer[]

  @@unique([cohort, fieldKey])
  @@unique([cohort, order])
  @@unique([cohort, displayOrder])
  @@index([cohort])
  @@map("assessment_questions")
}

enum AssessmentAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model AssessmentAttempt {
  id          String                  @id @default(cuid())
  studentId   String
  student     Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  cohort      String // which AssessmentQuestion.cohort set this attempt is answering
  status      AssessmentAttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime                @default(now())
  submittedAt DateTime?

  answers AssessmentAnswer[]
  result  AssessmentResult?

  @@index([studentId])
  @@map("assessment_attempts")
}

model AssessmentAnswer {
  id                       String             @id @default(cuid())
  attemptId                String
  attempt                  AssessmentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId               String
  question                 AssessmentQuestion @relation(fields: [questionId], references: [id])
  selectedOption           Json
  // Per-question elapsed time (ms). Used by the aptitude Time Consistency component of
  // ARI; optional because the current frontend doesn't send it yet — TC/ARI activate
  // automatically once every aptitude answer carries it.
  timeTakenMs              Int?
  // Counsellor override (Counsellor Chart mirror-pair amendment). When set, scoring uses
  // this instead of selectedOption; the student's original selectedOption is preserved.
  counsellorOverrideOption Json?
  overriddenByCounsellorId String?
  overriddenAt             DateTime?

  @@unique([attemptId, questionId])
  @@map("assessment_answers")
}

model AssessmentResult {
  id        String            @id @default(cuid())
  attemptId String            @unique
  attempt   AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Flat 18-trait score map { TRAIT_KEY: 0-100 } — handy for querying/aggregation.
  traitScores              Json
  // Full computed report (see src/modules/assessment/scoring AssessmentReport): layer
  // scores + grades, DCS/DPS, Stream Fit, reliability dashboard. Career Fit, RVS and
  // Time-Consistency/ARI are populated once their pending decisions land.
  report                   Json
  // Denormalized headline outputs for quick lookups without parsing `report`.
  recommendedStreams       String[] // Stream Fit top-3 sub-stream names
  dominantCareerStyle      String? // RIASEC-120 style label
  dominantPersonalityStyle String? // Big Five-20 style label
  engineVersion            String   @default("v1")

  summary   String?
  createdAt DateTime @default(now())

  @@map("assessment_results")
}

// Lazily created when the counsellor first opens a student's chart. The chart is
// assembled live (student profile + both pre-counselling questionnaires + assessment
// result + career library); only the counsellor-authored fields below are persisted.
// See src/modules/counsellor-chart/ and docs/6.Class 910_Counsellor Form Chart.pdf.
model CounsellorChart {
  id              String   @id @default(cuid())
  studentId       String   @unique
  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  strengths       String[]
  hobbies         String[]
  careerShortlist String[] // narrowed from 6 to 2 across sessions
  rawData         Json? // optional snapshot; the chart is assembled live on GET

  // SCRI — Student Career Readiness Index (counsellor-rated after Session 2). Each
  // indicator 1-4; total/band/label are derived on save and stored for convenience.
  scriConfidence        Int?
  scriReasonedThinking  Int?
  scriReducedAnxiety    Int?
  scriSelfAwareness     Int?
  scriCareerCuriosity   Int?
  scriDecisionOwnership Int?
  scriTotal             Int? // 6-24
  scriBand              Int? // 1-4
  scriBandLabel         String? // "PreExploration" .. "Career Ready"

  academicTrend   AcademicTrend? // A5
  alignmentRating AlignmentRating? // Academic × Career Alignment

  lastEditedBy String? // Counsellor id (audit stamp; not an FK, matching other modules)
  finalizedAt  DateTime? // set on /finalize, which advances workflow to COUNSELLOR_FEEDBACK
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  notes CounsellorChartNote[]

  @@map("counsellor_charts")
}

// One counsellor "Synthesis Note" per chart section code (A1..H4). Child table (not a
// JSON blob) so notes update independently and carry their own updatedAt.
model CounsellorChartNote {
  id        String          @id @default(cuid())
  chartId   String
  chart     CounsellorChart @relation(fields: [chartId], references: [id], onDelete: Cascade)
  code      String // "A1".."H4"
  body      String
  updatedAt DateTime        @updatedAt

  @@unique([chartId, code])
  @@map("counsellor_chart_notes")
}

enum AcademicTrend {
  IMPROVING
  STABLE
  DECLINING
  NOT_ASSESSED
}

enum AlignmentRating {
  STRONGLY_ALIGNED
  PARTIALLY_ALIGNED
  MISALIGNED
  NOT_YET_ASSESSED
}

enum ReportType {
  STUDENT_CAREER_PATH
  PARENT_SUMMARY
  INSTITUTION_SUMMARY
}

model Report {
  id                      String     @id @default(cuid())
  studentId               String
  student                 Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  generatedByCounsellorId String
  type                    ReportType
  fileUrl                 String
  generatedAt             DateTime   @default(now())

  @@index([studentId])
  @@map("reports")
}
