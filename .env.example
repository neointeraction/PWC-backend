# Server
NODE_ENV=development
PORT=4000

# Database (local Postgres role/db: pwc / pwc_counselling)
DATABASE_URL="postgresql://pwc:pwc_dev_password@localhost:5432/pwc_counselling?schema=public"

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin bootstrap (prisma/seed.ts) — the only login the app can create for you,
# since there's no self-register endpoint. Change this password before running the
# seed anywhere other than local dev.
SEED_SUPER_ADMIN_EMAIL=superadmin@kreate.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!

# CORS
CORS_ORIGIN=http://localhost:3000

# Email
# EMAIL_PROVIDER=console just logs emails to stdout — safe default for local dev.
# Switch to EMAIL_PROVIDER=mailgun and fill in the Mailgun vars to actually send.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=Team kREATE
EMAIL_FROM_ADDRESS=noreply@example.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
